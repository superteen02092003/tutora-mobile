<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: không đưa dữ liệu app vào bản sao lưu cloud hay khi chuyển sang
     máy mới. Xem ghi chú ở <application> trong AndroidManifest.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
